---
import ContactForm from '../components/ui/ContactForm.tsx';
---

<section id="contacto" class="relative py-20 lg:py-28 bg-[#070A12] overflow-hidden">
    <!-- Ambient mesh background glows -->
    <div class="absolute top-1/4 left-10 w-[28rem] h-[28rem] bg-[#004B95]/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-[30rem] h-[30rem] bg-[#FE7F01]/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-stretch">

            <!-- Left Info Column (5 cols) -->
            <div class="lg:col-span-5 flex flex-col justify-between space-y-8">
                <div>
                    <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#FE7F01] bg-[#FE7F01]/10 border border-[#FE7F01]/30 mb-4">
                        📍 Asesoría Personalizada
                    </span>
                    
                    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.12] mb-5">
                        POTENCIA TUS ENVÍOS CON <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE7F01] to-[#FFA14A]">
                            DALE DELIVERY
                        </span>
                    </h2>

                    <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 font-normal">
                        Compártenos tus datos y un especialista logístico te brindará <span class="text-white font-semibold">asesoría a medida</span> para optimizar tus tiempos de entrega, reducir costos y elevar la satisfacción de tus clientes.
                    </p>
                </div>

                <!-- Direct WhatsApp Hotline Card -->
                <div class="p-6 rounded-2xl bg-gradient-to-br from-[#0D1322] to-[#121A2D] border border-[#1E2C4A] shadow-xl relative overflow-hidden">
                    <div class="absolute -right-8 -bottom-8 w-28 h-28 bg-[#004B95]/20 rounded-full blur-xl pointer-events-none"></div>
                    
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#2563EB] to-[#004B95] flex items-center justify-center text-white shadow-md">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="text-xs font-bold uppercase tracking-wider text-[#FE7F01]">Atención Directa</div>
                            <div class="text-white font-extrabold text-sm sm:text-base">+51 928 095 900</div>
                        </div>
                    </div>

                    <p class="text-xs text-slate-300 leading-relaxed mb-4">
                        ¿Prefieres hablar directamente con un asesor ahora mismo? Haz clic abajo para iniciar un chat instantáneo.
                    </p>

                    <a
                        href="https://wa.me/928095900?text=Hola,%20quisiera%20solicitar%20asesoría%20para%20envíos%20con%20Dale%20Delivery"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 w-full bg-[#004B95] hover:bg-[#003B75] text-white font-bold text-xs sm:text-sm py-2.5 px-4 rounded-xl transition-all duration-300 border border-blue-500/40"
                    >
                        <span>Escribir por WhatsApp</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </a>
                </div>

                <!-- Coverage Badge -->
                <div class="flex items-center justify-between text-xs text-slate-400 px-2">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                        Cobertura en toda Lima y Callao
                    </span>
                    <span>Lun - Sáb: 8am - 7pm</span>
                </div>
            </div>

            <!-- Right Form Column (7 cols) -->
            <div class="lg:col-span-7 flex">
                <div class="bg-[#0D1322]/95 border border-[#1E2C4A] rounded-2xl p-6 sm:p-8 lg:p-10 shadow-2xl backdrop-blur-xl w-full flex flex-col justify-center">
                    <ContactForm client:load/>
                </div>
            </div>

        </div>
    </div>
</section>