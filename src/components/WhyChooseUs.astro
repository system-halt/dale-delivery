---
import WhyChooseCard from './ui/WhyChooseCard.astro';
---

<section id="por-que-elegirnos" class="relative py-20 lg:py-28 bg-[#070A12] overflow-hidden">
    <!-- Ambient mesh background glows -->
    <div class="absolute top-1/3 -right-24 w-96 h-96 bg-[#FE7F01]/10 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 -left-24 w-96 h-96 bg-[#004B95]/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-7xl">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#2563EB] bg-[#004B95]/15 border border-blue-500/30 mb-4">
                🛡️ Ventajas Competitivas
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
                ¿POR QUÉ ELEGIR <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE7F01] to-[#FFA14A]">DALE DELIVERY?</span>
            </h2>
            <p class="text-slate-300 text-base sm:text-lg lg:text-xl leading-relaxed">
                Diseñamos un servicio pensado en el éxito de tu negocio: máxima puntualidad, tarifas transparentes y soporte continuo.
            </p>
        </div>

        <!-- 6 Benefits Responsive Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            <!-- 1. Entregas rápidas -->
            <WhyChooseCard
                title="Entregas Rápidas"
                subtitle="Velocidad y precisión en cada ruta sin comprometer la seguridad de tus paquetes."
                iconSrc="/icons/truck-icon.png"
                iconAlt="Camión de entregas rápidas"
                accentColor="orange"
            />

            <!-- 2. Rastreo en tiempo real -->
            <WhyChooseCard
                title="Rastreo en Tiempo Real"
                subtitle="Monitoreo GPS continuo para que tú y tus clientes conozcan el estado exacto del envío."
                iconSrc="/icons/hand-icon.png"
                iconAlt="Rastreo en tiempo real"
                accentColor="blue"
            />

            <!-- 3. Logística estable -->
            <WhyChooseCard
                title="Logística Estable"
                subtitle="Cierres claros de registro hasta las 11:00 a.m. y medio día para Mercado Libre y Flex."
                iconSrc="/icons/agenda-icon.png"
                iconAlt="Logística estable"
                accentColor="orange"
            />

            <!-- 4. Precios competitivos -->
            <WhyChooseCard
                title="Precios Competitivos"
                subtitle="Tarifas transparentes desde S/6.00 diseñadas para maximizar tus márgenes de ganancia."
                iconSrc="/icons/money-icon.png"
                iconAlt="Precios competitivos"
                accentColor="blue"
            />

            <!-- 5. Entregas el mismo día -->
            <WhyChooseCard
                title="Entregas el Mismo Día"
                subtitle="Garantizamos entregas en menos de 24 horas para una experiencia de compra insuperable."
                iconSrc="/icons/calendar-icon.png"
                iconAlt="Entregas el mismo día"
                accentColor="orange"
            />

            <!-- 6. Facturación y formalidad -->
            <WhyChooseCard
                title="Facturación Formal"
                subtitle="Todos nuestros precios incluyen IGV. Sin cobros ocultos ni sorpresas en tu liquidación."
                iconSrc="/icons/factura-icon.png"
                iconAlt="Facturación electrónica con IGV"
                accentColor="blue"
            />
        </div>
    </div>
</section>