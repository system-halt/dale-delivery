---
import ServiceCard from './ui/ServiceCard.astro';
import PlansCard from './ui/PlansCard.astro';
---

<section id="servicios" class="relative py-20 lg:py-28 bg-[#090D18] overflow-hidden">
    <!-- Ambient light glow -->
    <div class="absolute top-1/2 left-0 w-96 h-96 bg-[#004B95]/15 rounded-full blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-[#FE7F01]/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="w-full px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-7xl mx-auto">

            <!-- Section Header -->
            <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
                <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#FE7F01] bg-[#FE7F01]/10 border border-[#FE7F01]/30 mb-4">
                    ⚡ Soluciones Logísticas
                </span>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
                    NUESTROS <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FE7F01] to-[#FFA14A]">SERVICIOS</span>
                </h2>
                <p class="text-slate-300 text-base sm:text-lg lg:text-xl leading-relaxed">
                    Entregas rápidas, seguras y confiables adaptadas al ritmo y volumen de tu negocio en Lima y Callao.
                </p>
            </div>

            <!-- Two-Column Grid: Services (Left) + Prepago Plans (Right) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">

                <!-- Left Column: Same Day & Next Day Cards (7 cols) -->
                <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 h-full">
                        <!-- Same Day Card -->
                        <div class="h-full">
                            <ServiceCard
                                title="SAME DAY"
                                subtitle="¿Tienes urgencia hoy?"
                                description="Recogemos y entregamos tu paquete en cuestión de horas el mismo día. Máxima velocidad sin complicaciones."
                                imageBg="/same-day.jpg"
                                type="same-day"
                                badgeText="⚡ Express Mismo Día"
                                features={[
                                    "Recojo y entrega el mismo día",
                                    "Rastreo en tiempo real",
                                    "Confirmación digital de entrega"
                                ]}
                            />
                        </div>

                        <!-- Next Day Card -->
                        <div class="h-full">
                            <ServiceCard
                                title="NEXT DAY"
                                subtitle="Planifica con tranquilidad"
                                description="Recogemos hoy y entregamos mañana en toda Lima y Callao con la tarifa más conveniente del mercado."
                                imageBg="/next-day.jpg"
                                type="next-day"
                                badgeText="📦 Económico 24h"
                                features={[
                                    "Recojo hoy, entrega mañana",
                                    "Tarifas desde S/6.00",
                                    "Cobertura integral Lima y Callao"
                                ]}
                            />
                        </div>
                    </div>
                </div>

                <!-- Right Column: Prepago Plans Card (6 cols) -->
                <div class="lg:col-span-6 flex flex-col h-full">
                    <PlansCard
                        title="PLANES DE ENVÍOS PREPAGO"
                        subtitle="Ahorra hasta 25% en tus costos de courier comprando paquetes de envíos por adelantado."
                        plans={[
                            'Plan Start 10 envíos',
                            'Plan Crece 20 envíos',
                            'Plan Pro 50 envíos',
                            'Plan Elite 100 envíos',
                            'Plan Ultra 200 envíos'
                        ]}
                        footerText="Precios desde S/7.50 / envío"
                        imageSrc="/plancard.jpg"
                        imageAlt="Repartidor de Dale Delivery entregando paquete"
                    />
                </div>
            </div>

        </div>
    </div>
</section>