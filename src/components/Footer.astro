---
---
<footer class="bg-[#05070D] border-t border-[#1E2C4A] text-slate-300 pt-16 pb-12 overflow-hidden">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 items-start pb-12 border-b border-[#1E2C4A]/80">
            
            <!-- Columna Izquierda: Logo y Datos de Contacto (5 cols) -->
            <div class="md:col-span-5 flex flex-col space-y-6">
                <!-- Logo -->
                <a href="/" class="inline-block hover:opacity-95 transition-opacity">
                    <img src="/logo.png" alt="Dale Delivery Logo" class="h-14 sm:h-16 w-auto object-contain filter drop-shadow-[0_2px_10px_rgba(254,127,1,0.2)]"/>
                </a>

                <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
                    Tu aliado logístico de confianza en Lima y Callao. Entregas Same Day y Next Day directas, rápidas y seguras.
                </p>

                <!-- Contact Info List -->
                <div class="space-y-3 text-xs sm:text-sm text-slate-300">
                    <div class="flex items-center space-x-3 group">
                        <div class="w-8 h-8 rounded-lg bg-[#004B95]/20 text-blue-400 flex items-center justify-center flex-shrink-0 border border-blue-500/30 group-hover:border-blue-500/60 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 3a9 9 0 1 0 9 9 9.01 9.01 0 0 0-9-9zm0 0a13.38 13.38 0 0 1 0 18"/>
                            </svg>
                        </div>
                        <span class="text-slate-300 font-medium">daledelivery.pe</span>
                    </div>

                    <div class="flex items-center space-x-3 group">
                        <div class="w-8 h-8 rounded-lg bg-[#FE7F01]/15 text-[#FE7F01] flex items-center justify-center flex-shrink-0 border border-[#FE7F01]/30 group-hover:border-[#FE7F01]/60 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M4 4h16v16H4z" stroke="none"/>
                                <path d="M4 4l8 8 8-8"/>
                            </svg>
                        </div>
                        <span class="text-slate-300 font-medium">contacto@daledelivery.pe</span>
                    </div>

                    <div class="flex items-center space-x-3 group">
                        <div class="w-8 h-8 rounded-lg bg-[#004B95]/20 text-blue-400 flex items-center justify-center flex-shrink-0 border border-blue-500/30 group-hover:border-blue-500/60 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M12 21s-6-5-6-10a6 6 0 0 1 12 0c0 5-6 10-6 10z"/>
                                <circle cx="12" cy="11" r="2"/>
                            </svg>
                        </div>
                        <span class="text-slate-300 font-medium">Lima - Callao, Perú</span>
                    </div>

                    <div class="flex items-center space-x-3 group">
                        <div class="w-8 h-8 rounded-lg bg-[#FE7F01]/15 text-[#FE7F01] flex items-center justify-center flex-shrink-0 border border-[#FE7F01]/30 group-hover:border-[#FE7F01]/60 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M22 16.92V21a2 2 0 0 1-2.18 2 19.9 19.9 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.07 12.8 19.9 19.9 0 0 1 0 4.18 2 2 0 0 1 2 2h4.09a2 2 0 0 1 2 1.72 12.4 12.4 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.1 10.9a16 16 0 0 0 6 6l2.26-1.19a2 2 0 0 1 2.11-.45 12.4 12.4 0 0 0 2.81.7 2 2 0 0 1 1.72 2z"/>
                            </svg>
                        </div>
                        <span class="text-slate-300 font-medium">+51 928 095 900</span>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Enlaces Rápidos (7 cols en 3 subcolumnas) -->
            <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-8">
                <!-- Servicios -->
                <div>
                    <h3 class="font-extrabold text-white text-base tracking-wide uppercase mb-4 text-[#FE7F01]">
                        Servicios
                    </h3>
                    <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
                        <li>
                            <a href="#servicios" class="hover:text-[#FE7F01] transition-colors flex items-center gap-1.5">
                                <span class="text-[#FE7F01]">›</span> Same Day (Mismo Día)
                            </a>
                        </li>
                        <li>
                            <a href="#servicios" class="hover:text-[#FE7F01] transition-colors flex items-center gap-1.5">
                                <span class="text-[#FE7F01]">›</span> Next Day (Día Siguiente)
                            </a>
                        </li>
                        <li>
                            <a href="#servicios" class="hover:text-[#FE7F01] transition-colors flex items-center gap-1.5">
                                <span class="text-[#FE7F01]">›</span> Planes Prepago
                            </a>
                        </li>
                        <li>
                            <a href="#servicios" class="hover:text-[#FE7F01] transition-colors flex items-center gap-1.5">
                                <span class="text-[#FE7F01]">›</span> Mercado Libre & Flex
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Ventajas -->
                <div>
                    <h3 class="font-extrabold text-white text-base tracking-wide uppercase mb-4 text-[#2563EB]">
                        Ventajas
                    </h3>
                    <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
                        <li class="flex items-center gap-1.5">
                            <span class="text-blue-400">✓</span> Entregas en &lt; 24h
                        </li>
                        <li class="flex items-center gap-1.5">
                            <span class="text-blue-400">✓</span> Rastreo GPS en vivo
                        </li>
                        <li class="flex items-center gap-1.5">
                            <span class="text-blue-400">✓</span> Tarifas desde S/6.00
                        </li>
                        <li class="flex items-center gap-1.5">
                            <span class="text-blue-400">✓</span> Factura electrónica
                        </li>
                    </ul>
                </div>

                <!-- Contacto & Horarios -->
                <div>
                    <h3 class="font-extrabold text-white text-base tracking-wide uppercase mb-4 text-[#FE7F01]">
                        Horarios
                    </h3>
                    <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
                        <li>
                            <span class="block font-semibold text-white">Lunes a Sábado:</span>
                            <span class="text-slate-400">8:00 AM - 7:00 PM</span>
                        </li>
                        <li>
                            <span class="block font-semibold text-white">Cierre Registro General:</span>
                            <span class="text-slate-400">11:00 AM</span>
                        </li>
                        <li>
                            <span class="block font-semibold text-white">Cierre Mercado Flex:</span>
                            <span class="text-slate-400">12:00 PM (Medio día)</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        <!-- Bottom: Social Links and Legal -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-slate-400">
            <p>
                © 2025 Dale Delivery. Todos los derechos reservados.
            </p>

            <!-- Social Media Buttons with Glow -->
            <div class="flex items-center space-x-3">
                <!-- Facebook -->
                <a
                    href="https://www.facebook.com/daledelivery.pe?locale=es_LA"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook Dale Delivery"
                    class="w-10 h-10 rounded-full bg-slate-900 border border-[#1E2C4A] hover:border-blue-500 text-slate-300 hover:text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_rgba(37,99,235,0.4)]"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                </a>

                <!-- Instagram -->
                <a
                    href="https://www.instagram.com/daledelivery.pe/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram Dale Delivery"
                    class="w-10 h-10 rounded-full bg-slate-900 border border-[#1E2C4A] hover:border-[#FE7F01] text-slate-300 hover:text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_rgba(254,127,1,0.4)]"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                </a>

                <!-- TikTok -->
                <a
                    href="https://www.tiktok.com/@daledelivery"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="TikTok Dale Delivery"
                    class="w-10 h-10 rounded-full bg-slate-900 border border-[#1E2C4A] hover:border-blue-400 text-slate-300 hover:text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_rgba(56,189,248,0.4)]"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                    </svg>
                </a>

                <!-- WhatsApp -->
                <a
                    href="https://wa.me/928095900?text=Hola,%20me%20interesa%20cotizar%20un%20envío%20con%20Dale%20Delivery"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="WhatsApp Dale Delivery"
                    class="w-10 h-10 rounded-full bg-slate-900 border border-[#1E2C4A] hover:border-emerald-500 text-slate-300 hover:text-white flex items-center justify-center transition-all duration-300 hover:scale-110 hover:shadow-[0_0_15px_rgba(16,185,129,0.4)]"
                >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</footer>

