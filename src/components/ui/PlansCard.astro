---
export interface Props {
    title: string;
    subtitle: string;
    plans: string[];
    footerText: string;
    imageSrc: string;
    imageAlt: string;
}

const { title, subtitle, plans, footerText, imageSrc, imageAlt } = Astro.props;
---

<div class="relative bg-[#0D1322]/95 border border-[#1E2C4A] rounded-2xl overflow-hidden shadow-2xl hover:border-[#FE7F01]/50 transition-all duration-300 transform hover:-translate-y-1.5 backdrop-blur-xl flex flex-col h-full">
    <!-- Top Header Ribbon -->
    <div class="relative bg-gradient-to-r from-[#FE7F01] via-[#e57200] to-[#004B95] p-6 sm:p-7 text-white overflow-hidden">
        <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
        <div class="flex items-center justify-between gap-4 mb-2">
            <span class="inline-block px-3 py-1 bg-black/30 backdrop-blur-md rounded-full text-[11px] font-extrabold uppercase tracking-wider text-white border border-white/20">
                ⭐ Planes Prepago
            </span>
            <span class="inline-block px-3 py-1 bg-white text-[#FE7F01] rounded-full text-xs font-black shadow">
                HASTA 25% OFF
            </span>
        </div>
        <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold leading-tight tracking-tight mb-2">
            {title}
        </h3>
        <p class="text-xs sm:text-sm text-white/90 leading-relaxed font-medium">
            {subtitle}
        </p>
    </div>

    <!-- Body Layout (2 Columns on tablet/desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-12 flex-grow">
        <!-- Left Plans List (7 cols) -->
        <div class="md:col-span-7 p-6 sm:p-7 flex flex-col justify-between space-y-6">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
                    Paquetes de envíos disponibles:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-1 gap-2.5">
                    {plans.map((plan, index) => (
                        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/80 border border-[#1E2C4A] hover:border-[#2563EB]/60 hover:bg-slate-800/60 transition-all duration-200">
                            <div class="flex items-center gap-2.5">
                                <div class="w-5 h-5 rounded-full bg-[#004B95]/30 text-blue-400 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                                <span class="text-sm font-bold text-white tracking-wide">{plan}</span>
                            </div>
                            <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-[#FE7F01]/15 text-[#FE7F01] border border-[#FE7F01]/30">
                                {index === 0 ? "Básico" : index === 1 ? "Popular" : index === 2 ? "Pro" : "Empresas"}
                            </span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Price callout & CTA -->
            <div class="pt-4 border-t border-[#1E2C4A]/70">
                <div class="flex items-baseline gap-2 mb-3">
                    <span class="text-xs text-slate-400 font-medium">Tarifas preferenciales:</span>
                    <span class="text-lg sm:text-xl font-extrabold text-[#FE7F01]">{footerText}</span>
                </div>
                <a
                    href="https://wa.me/928095900?text=Hola,%20me%20gustaría%20información%20sobre%20los%20Planes%20de%20Envíos%20Prepago"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-[#FE7F01] to-[#FF5500] hover:from-[#e57200] hover:to-[#eb4d00] text-white font-bold text-sm py-3 px-5 rounded-xl shadow-lg shadow-[#FE7F01]/25 transition-all duration-300 transform hover:-translate-y-0.5"
                >
                    <span>Adquirir Plan Prepago</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        </div>

        <!-- Right Side Image (5 cols) -->
        <div class="md:col-span-5 relative min-h-[220px] md:min-h-full overflow-hidden">
            <img
                src={imageSrc}
                alt={imageAlt}
                class="w-full h-full object-cover object-center filter brightness-90 contrast-110"
                loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t md:bg-gradient-to-r from-[#0D1322] via-transparent to-black/20"></div>
            
            <!-- Float Benefit Badge -->
            <div class="absolute bottom-4 left-4 right-4 bg-[#070A12]/80 backdrop-blur-md p-3 rounded-xl border border-[#1E2C4A] text-left shadow-lg">
                <div class="text-[#FE7F01] text-xs font-bold flex items-center gap-1.5 mb-0.5">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Ahorro Garantizado
                </div>
                <p class="text-[11px] text-slate-300 leading-tight">
                    Recarga tu saldo y gestiona envíos sin preocuparte por pagos diarios.
                </p>
            </div>
        </div>
    </div>
</div>