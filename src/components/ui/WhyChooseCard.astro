---
export interface Props {
    title: string;
    subtitle: string;
    iconSrc: string;
    iconAlt: string;
    accentColor?: "orange" | "blue";
}

const { 
    title, 
    subtitle, 
    iconSrc, 
    iconAlt,
    accentColor = "orange"
} = Astro.props;

const isOrange = accentColor === "orange";
const haloClass = isOrange ? "bg-[#FE7F01]/15 text-[#FE7F01] border-[#FE7F01]/30 group-hover:border-[#FE7F01]/60 group-hover:shadow-[0_0_20px_rgba(254,127,1,0.3)]" : "bg-[#004B95]/20 text-blue-400 border-blue-500/30 group-hover:border-blue-500/60 group-hover:shadow-[0_0_20px_rgba(37,99,235,0.3)]";
const checkBgClass = isOrange ? "bg-[#FE7F01] text-white" : "bg-[#2563EB] text-white";
const borderHoverClass = isOrange ? "hover:border-[#FE7F01]/50" : "hover:border-blue-500/50";
---

<div class={`group relative flex flex-col items-center text-center p-6 sm:p-7 rounded-2xl bg-[#0D1322]/85 border border-[#1E2C4A] ${borderHoverClass} hover:bg-[#121A2D] transition-all duration-300 transform hover:-translate-y-2 shadow-lg backdrop-blur-xl h-full`}>
    <!-- Top Corner Indicator Badge -->
    <div class="absolute top-4 right-4">
        <div class={`w-5 h-5 rounded-full ${checkBgClass} flex items-center justify-center shadow-md`}>
            <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
        </div>
    </div>

    <!-- Icon Container with Glowing Aura -->
    <div class={`w-20 h-20 sm:w-22 sm:h-22 rounded-2xl ${haloClass} border flex items-center justify-center p-4 mb-5 transition-all duration-300`}>
        <img
            src={iconSrc}
            alt={iconAlt}
            class="w-full h-full object-contain filter drop-shadow-[0_4px_8px_rgba(0,0,0,0.5)] group-hover:scale-110 transition-transform duration-300"
            loading="lazy"
        />
    </div>

    <!-- Title -->
    <h3 class="text-lg sm:text-xl font-extrabold text-white mb-2.5 tracking-tight group-hover:text-white transition-colors">
        {title}
    </h3>

    <!-- Subtitle / Description -->
    <p class="text-slate-300 text-xs sm:text-sm leading-relaxed font-normal">
        {subtitle}
    </p>
</div>