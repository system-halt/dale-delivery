---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';

---

<Layout lang="es">
    <Header/>
    <main class="relative overflow-hidden bg-[#070A12]">
        <HeroSection/>
        <ServicesSection/>
        <WhyChooseUs/>
        <ContactSection/>
    </main>
    <Footer/>
</Layout>

<style is:global>
    /* Efectos de pulso y resplandor con colores oficiales */
    @keyframes pulse-orange-glow {
        0%, 100% {
            box-shadow: 0 0 15px rgba(254, 127, 1, 0.35);
        }
        50% {
            box-shadow: 0 0 35px rgba(254, 127, 1, 0.65);
        }
    }

    @keyframes pulse-blue-glow {
        0%, 100% {
            box-shadow: 0 0 15px rgba(37, 99, 235, 0.35);
        }
        50% {
            box-shadow: 0 0 35px rgba(37, 99, 235, 0.65);
        }
    }

    .animate-pulse-glow {
        animation: pulse-orange-glow 2.5s ease-in-out infinite;
    }

    .animate-pulse-blue {
        animation: pulse-blue-glow 2.5s ease-in-out infinite;
    }

    /* Glassmorphism oscuro */
    .glass-dark {
        background: rgba(18, 26, 45, 0.7);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(30, 44, 74, 0.8);
    }

    .glass-dark-card {
        background: linear-gradient(135deg, rgba(18, 26, 45, 0.85) 0%, rgba(13, 19, 34, 0.75) 100%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(30, 44, 74, 0.7);
    }

    /* Focus accesible en tema oscuro */
    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
        outline: 2px solid #FE7F01;
        outline-offset: 2px;
    }

    /* Reducción de movimiento */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>